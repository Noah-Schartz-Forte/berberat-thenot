---
// One form field: label, control, optional hint, error slot.
// Compose inside <Form>. See DESIGN.md for a full example.
//
//   <Field name="nom" label="Nom et prénom" required autocomplete="name" />
//   <Field name="email" label="E-mail" type="email" required autocomplete="email" />
//   <Field name="besoin" label="Votre besoin" as="select" required
//          options={[{ value: 'transport', label: 'Transport' }]} />
//   <Field name="message" label="Message" as="textarea" full minlength={10} />
//
// The error <p> is filled by form.client.ts (client validation) or from the
// API's `fields` map; the control's aria-describedby always points at the
// hint (if any) and the error, and aria-invalid is toggled with it.
export interface Option {
  value: string;
  label: string;
}

export interface Props {
  name: string;
  label: string;
  as?: 'input' | 'select' | 'textarea' | 'checkbox';
  type?: 'text' | 'email' | 'tel' | 'url' | 'number';
  required?: boolean;
  autocomplete?: string;
  hint?: string;
  placeholder?: string;
  options?: Option[];
  /** Label of the empty first <option> of a select. */
  emptyOption?: string;
  rows?: number;
  minlength?: number;
  maxlength?: number;
  inputmode?: 'text' | 'email' | 'tel' | 'url' | 'numeric' | 'decimal' | 'search' | 'none';
  /** Span both columns of the form grid. */
  full?: boolean;
  value?: string;
  /** Prefix for the id, needed when two forms on one page share a field name. */
  idPrefix?: string;
}

const {
  name,
  label,
  as = 'input',
  type = 'text',
  required = false,
  autocomplete,
  hint,
  placeholder,
  options = [],
  emptyOption = 'Choisir…',
  rows = 6,
  minlength,
  maxlength,
  inputmode,
  full = as === 'textarea' || as === 'checkbox',
  value,
  idPrefix = 'f',
} = Astro.props;

const id = `${idPrefix}-${name}`;
const hintId = hint ? `${id}-hint` : undefined;
const errorId = `${id}-error`;
const describedBy = [hintId, errorId].filter(Boolean).join(' ');
const hasSlot = Astro.slots.has('default');
---

<div class:list={['field', `field--${as}`, full && 'field--full']} data-field>
  {
    as === 'checkbox' ? (
      <div class="field__check">
        <input
          id={id}
          name={name}
          type="checkbox"
          value="on"
          required={required}
          aria-describedby={describedBy}
        />
        <label for={id}>{hasSlot ? <slot /> : label}{required && <span class="field__req" aria-hidden="true"> *</span>}</label>
      </div>
    ) : (
      <>
        <label class="field__label" for={id}>
          {label}
          {required ? <span class="field__req" aria-hidden="true"> *</span> : <span class="field__opt"> (facultatif)</span>}
        </label>
        {as === 'select' ? (
          <div class="field__select">
            <select id={id} name={name} required={required} autocomplete={autocomplete} aria-describedby={describedBy}>
              <option value="">{emptyOption}</option>
              {options.map((o) => (
                <option value={o.value} selected={o.value === value}>{o.label}</option>
              ))}
            </select>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
          </div>
        ) : as === 'textarea' ? (
          <textarea
            id={id}
            name={name}
            rows={rows}
            required={required}
            minlength={minlength}
            maxlength={maxlength ?? 5000}
            placeholder={placeholder}
            aria-describedby={describedBy}
          >{value}</textarea>
        ) : (
          <input
            id={id}
            name={name}
            type={type}
            required={required}
            autocomplete={autocomplete}
            inputmode={inputmode}
            minlength={minlength}
            maxlength={maxlength ?? 200}
            placeholder={placeholder}
            value={value}
            aria-describedby={describedBy}
            spellcheck={type === 'email' || type === 'url' || type === 'tel' ? 'false' : undefined}
          />
        )}
      </>
    )
  }
  {hint && <p class="field__hint" id={hintId}>{hint}</p>}
  <p class="field__error" id={errorId} data-field-error hidden></p>
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .field--full {
    grid-column: 1 / -1;
  }
  .field__label {
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    color: var(--fg);
  }
  .field__req {
    color: var(--accent-text);
  }
  .field__opt {
    font-weight: var(--fw-regular);
    color: var(--fg-muted);
  }
  input:not([type='checkbox']),
  select,
  textarea {
    width: 100%;
    min-height: 52px;
    padding: 14px 16px;
    border: 1.5px solid var(--grey-400);
    border-radius: var(--radius-1);
    background: var(--paper);
    color: var(--grey-900);
    font-size: 1rem; /* 16px: no iOS zoom on focus */
    line-height: 1.4;
    transition:
      border-color var(--dur) var(--ease-std),
      box-shadow var(--dur) var(--ease-std);
  }
  textarea {
    resize: vertical;
    min-height: 140px;
  }
  input::placeholder,
  textarea::placeholder {
    color: var(--grey-500);
  }
  @media (hover: hover) {
    input:not([type='checkbox']):hover,
    select:hover,
    textarea:hover {
      border-color: var(--grey-700);
    }
  }
  input:not([type='checkbox']):focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 2px;
    border-color: var(--grey-900);
  }
  [aria-invalid='true'] {
    border-color: var(--red-text) !important;
    box-shadow: inset 3px 0 0 var(--red-text);
  }

  .field__select {
    position: relative;
  }
  .field__select select {
    appearance: none;
    padding-right: 44px;
    cursor: pointer;
  }
  .field__select svg {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--grey-700);
  }

  .field__check {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: var(--fs-small);
    color: var(--fg-2);
    line-height: 1.55;
  }
  .field__check input {
    flex: none;
    width: 22px;
    height: 22px;
    margin: 1px 0 0;
    accent-color: var(--red);
    cursor: pointer;
  }
  .field__check label {
    cursor: pointer;
  }
  .field__check label :global(a) {
    color: var(--fg);
  }

  .field__hint {
    font-size: var(--fs-small);
    color: var(--fg-muted);
  }
  .field__error {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    color: var(--red-text);
  }
  .field__error::before {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    background: var(--red-text);
  }
  :global(.is-dark) .field__error {
    color: #ff8a8e;
  }
  :global(.is-dark) .field__error::before {
    background: #ff8a8e;
  }
</style>
