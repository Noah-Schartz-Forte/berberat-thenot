---
// Inner page head: solid dark block with kicker, H1 and lead.
// Optional photo split on the right (desktop) / below (phone). The photo sits
// NEXT TO the text, never under it, so no overlay is needed.
//
//   <PageHead kicker="Métier" title="Logistique & entreposage"
//             lead="..." image={warehouseAerial} alt="..." />
//
//   <PageHead kicker="Contact" title="Nous contacter" lead="...">
//     <Button slot="actions" href="#devis">Demander un devis</Button>
//   </PageHead>
//
// Props: kicker?, title (plain text, uppercase via CSS), lead?, image?, alt?
// (required with image), crumbs? ([{label, href?}], a visual breadcrumb;
// "Accueil" is prepended), position? (object-position of the photo).
// Slot "actions": buttons under the lead.
// The photo is the LCP: eager + fetchpriority high. Low-res sources (800px)
// are fine here: the slot is capped at the image's native width.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { HALF_WIDTHS, HALF_SIZES, IMAGE_FORMATS, capWidths } from '../lib/images';

interface Crumb {
  label: string;
  href?: string;
}

export interface Props {
  kicker?: string;
  title: string;
  lead?: string;
  image?: ImageMetadata;
  alt?: string;
  crumbs?: Crumb[];
  position?: string;
}

const { kicker, title, lead, image, alt = '', crumbs, position = 'center' } = Astro.props;
const trail: Crumb[] = crumbs ? [{ label: 'Accueil', href: '/' }, ...crumbs] : [];
---

<section class:list={['pagehead is-dark', image && 'pagehead--split']} aria-labelledby="page-title">
  <div class="pagehead__inner container container--wide">
    <div class="pagehead__text">
      {
        trail.length > 0 && (
          <nav class="pagehead__crumbs" aria-label="Fil d’Ariane">
            <ol role="list">
              {trail.map((c, i) => (
                <li>
                  {c.href && i < trail.length - 1 ? (
                    <a href={c.href}>{c.label}</a>
                  ) : (
                    <span aria-current="page">{c.label}</span>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      {kicker && <p class="kicker pagehead__kicker">{kicker}</p>}
      <h1 id="page-title" class="h1 pagehead__title">{title}</h1>
      <span class="rule-red pagehead__rule" aria-hidden="true"></span>
      {lead && <p class="lead pagehead__lead">{lead}</p>}
      {Astro.slots.has('actions') && <div class="pagehead__actions"><slot name="actions" /></div>}
    </div>
    {
      image && (
        <div class="pagehead__media" style={`max-width: ${image.width}px`}>
          <Picture
            src={image}
            alt={alt}
            formats={IMAGE_FORMATS}
            widths={capWidths(image, HALF_WIDTHS)}
            sizes={HALF_SIZES}
            loading="eager"
            decoding="async"
            fetchpriority="high"
            style={`object-position: ${position}`}
          />
        </div>
      )
    }
  </div>
</section>

<style>
  .pagehead {
    background: var(--ink);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .pagehead__inner {
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    padding-block: clamp(3.5rem, 2.5rem + 4.5vw, 7rem);
  }
  .pagehead--split .pagehead__inner {
    padding-bottom: 0;
  }
  @media (min-width: 900px) {
    .pagehead--split .pagehead__inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      align-items: stretch;
      padding-block: 0;
    }
    .pagehead--split .pagehead__text {
      align-self: center;
      padding-block: clamp(4rem, 3rem + 4vw, 7rem);
    }
  }
  .pagehead__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
    margin-bottom: 28px;
    font-size: var(--fs-micro);
    font-weight: var(--fw-medium);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .pagehead__crumbs li + li::before {
    content: '/';
    margin: 0 10px;
    color: var(--grey-700);
  }
  .pagehead__crumbs a {
    color: var(--fg-2);
    text-decoration: none;
  }
  @media (hover: hover) {
    .pagehead__crumbs a:hover {
      color: #fff;
      text-decoration: underline;
    }
  }
  .pagehead__kicker {
    margin-bottom: 18px;
  }
  .pagehead__title {
    max-width: 18ch;
    text-wrap: balance;
  }
  .pagehead__rule {
    margin-top: 24px;
    width: 72px;
    height: 4px;
  }
  .pagehead__lead {
    margin-top: 24px;
    max-width: 54ch;
  }
  .pagehead__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 16px;
    margin-top: 32px;
  }
  .pagehead__media {
    position: relative;
    width: 100%;
    min-height: 280px;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--ink-2);
  }
  @media (min-width: 900px) {
    .pagehead__media {
      aspect-ratio: auto;
      min-height: 480px;
      justify-self: end;
    }
  }
  .pagehead__media :global(picture),
  .pagehead__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
