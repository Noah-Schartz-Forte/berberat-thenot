---
// Photo + text, side by side from 900px (stacked on phones, photo first).
//
//   <SplitSection image={warehouseAerial} alt="..." kicker="Logistique"
//                 title="20 000 m² de stockage intérieur" tone="grey" reverse>
//     <p>Texte...</p>
//     <Button slot="actions" href="/logistique" variant="dark">...</Button>
//   </SplitSection>
//
// Props
//   image, alt      the photo (alt in French, describes what is visible)
//   kicker?, title  heading (H2 by default, headingLevel 3 inside a page part)
//   tone?           'light' (default) | 'grey' | 'dark'
//   reverse?        photo on the right instead of the left
//   ratio?          photo aspect ratio on phones and as min height basis
//                   (default '4 / 3')
//   position?       object-position (default 'center')
//   caption?        small caption under the photo
//   id?             section id (anchor)
// Low-resolution sources (800px) are safe: the photo slot is capped at the
// image's native width, and widths never exceed the source.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { HALF_WIDTHS, HALF_SIZES, IMAGE_FORMATS, capWidths } from '../lib/images';

export interface Props {
  image: ImageMetadata;
  alt: string;
  kicker?: string;
  title: string;
  tone?: 'light' | 'grey' | 'dark';
  reverse?: boolean;
  ratio?: string;
  position?: string;
  caption?: string;
  headingLevel?: 2 | 3;
  id?: string;
}

const {
  image,
  alt,
  kicker,
  title,
  tone = 'light',
  reverse = false,
  ratio = '4 / 3',
  position = 'center',
  caption,
  headingLevel = 2,
  id,
} = Astro.props;
const H = headingLevel === 3 ? 'h3' : 'h2';
const toneClass = tone === 'dark' ? 'is-dark' : tone === 'grey' ? 'is-grey' : '';
const headingId = id ? `${id}-titre` : undefined;
---

<section class:list={['section split', toneClass, reverse && 'split--reverse']} id={id} aria-labelledby={headingId}>
  <div class="container split__grid">
    <figure class="split__media reveal" style={`max-width: ${image.width}px; --ratio: ${ratio}`}>
      <div class="split__frame">
        <Picture
          src={image}
          alt={alt}
          formats={IMAGE_FORMATS}
          widths={capWidths(image, HALF_WIDTHS)}
          sizes={HALF_SIZES}
          loading="lazy"
          decoding="async"
          style={`object-position: ${position}`}
        />
      </div>
      {caption && <figcaption class="split__caption">{caption}</figcaption>}
    </figure>
    <div class="split__text reveal" data-reveal-delay="80">
      {kicker && <p class="kicker split__kicker">{kicker}</p>}
      <H id={headingId} class:list={[headingLevel === 3 ? 'h3' : 'h2', 'split__title']}>{title}</H>
      <div class="prose split__body"><slot /></div>
      {Astro.slots.has('actions') && <div class="split__actions"><slot name="actions" /></div>}
    </div>
  </div>
</section>

<style>
  .split__grid {
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .split__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(3rem, 1rem + 4vw, 6rem);
    }
    .split--reverse .split__media {
      order: 2;
      justify-self: end;
    }
  }
  .split__media {
    width: 100%;
    margin: 0;
  }
  .split__frame {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--paper-3);
  }
  .split__frame :global(picture),
  .split__frame :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .split__caption {
    margin-top: 12px;
    padding-left: 14px;
    border-left: 2px solid var(--red);
    font-size: var(--fs-small);
    color: var(--fg-muted);
  }
  .split__kicker {
    margin-bottom: 16px;
  }
  .split__title {
    max-width: 18ch;
    text-wrap: balance;
  }
  .split__body {
    margin-top: 24px;
  }
  .split__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 16px;
    margin-top: 32px;
  }
</style>
