---
// Groupement FLO membership band with the network's figures (config FLO).
//
//   <FloBand image={floTrailer} alt="..." />
//   <FloBand tone="dark" showPageLink={false} title="..." />
//
// Props: title? (default "Membre du Groupement FLO"), kicker?, text?,
// image? + alt? (optional photo, capped at its native width), tone?
// ('grey' default | 'light' | 'dark'), showPageLink? (link to
// /groupement-flo, default true), headingLevel? (2).
// Always shows the outbound link to groupement-flo.com (new tab, noopener).
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { FLO } from '../config';
import Icon from './Icon.astro';
import Button from './Button.astro';
import { HALF_WIDTHS, HALF_SIZES, IMAGE_FORMATS, capWidths } from '../lib/images';

export interface Props {
  kicker?: string;
  title?: string;
  text?: string;
  image?: ImageMetadata;
  alt?: string;
  tone?: 'grey' | 'light' | 'dark';
  showPageLink?: boolean;
  headingLevel?: 2 | 3;
}

const {
  kicker = 'Réseau national',
  title = 'Membre du Groupement FLO',
  text = `Le groupe est membre du Groupement FLO (${FLO.fullName}), qui réunit 101 sociétés indépendantes. Grâce à ce réseau, le groupe accompagne ses clients au niveau national.`,
  image,
  alt = '',
  tone = 'grey',
  showPageLink = true,
  headingLevel = 2,
} = Astro.props;
const H = headingLevel === 3 ? 'h3' : 'h2';
const toneClass = tone === 'dark' ? 'is-dark' : tone === 'grey' ? 'is-grey' : '';
---

<section class:list={['section flo', toneClass, image && 'flo--image']} aria-labelledby="flo-titre">
  <div class="container flo__grid">
    {
      image && (
        <figure class="flo__media reveal" style={`max-width: ${image.width}px`}>
          <Picture
            src={image}
            alt={alt}
            formats={IMAGE_FORMATS}
            widths={capWidths(image, HALF_WIDTHS)}
            sizes={HALF_SIZES}
            loading="lazy"
            decoding="async"
          />
        </figure>
      )
    }
    <div class="flo__text reveal" data-reveal-delay="80">
      <p class="kicker">{kicker}</p>
      <H id="flo-titre" class="h2 flo__title">{title}</H>
      <p class="flo__lead">{text}</p>

      <dl class="flo__figures">
        {
          FLO.figures.map((f) => (
            <div class="flo__fig">
              <dt class="flo__label">{f.label}</dt>
              <dd class="flo__value">{f.value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="flo__actions">
        {
          showPageLink && (
            <Button href="/groupement-flo" variant={tone === 'dark' ? 'outline' : 'dark'} icon="arrow">
              Le Groupement FLO
            </Button>
          )
        }
        <a class="flo__out" href={FLO.url} target="_blank" rel="noopener">
          groupement-flo.com
          <Icon name="external" size={16} />
          <span class="visually-hidden">(nouvel onglet)</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .flo__grid {
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3rem);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .flo--image .flo__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: clamp(3rem, 1rem + 4vw, 6rem);
    }
  }
  .flo__media {
    width: 100%;
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--paper-3);
  }
  @media (max-width: 1023px) {
    .flo__media {
      aspect-ratio: 16 / 10;
    }
  }
  .flo__media :global(picture),
  .flo__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .flo__title {
    margin-top: 16px;
    max-width: 18ch;
  }
  .flo__lead {
    margin-top: 20px;
    max-width: 58ch;
    color: var(--fg-2);
  }
  .flo__figures {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 36px;
    border-top: 2px solid var(--rule-strong);
  }
  @media (min-width: 640px) {
    .flo__figures {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .flo__fig {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 6px;
    padding: 18px 12px 18px 0;
    border-bottom: 1px solid var(--rule);
  }
  .flo__value {
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    font-weight: var(--fw-black);
    line-height: 1.05;
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: var(--fg);
  }
  .flo__label {
    font-size: var(--fs-micro);
    font-weight: var(--fw-bold);
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--fg-2);
  }
  .flo__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
    margin-top: 32px;
  }
  .flo__out {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--red);
    text-underline-offset: 0.3em;
  }
  .flo__out :global(svg) {
    color: var(--red);
  }
</style>
