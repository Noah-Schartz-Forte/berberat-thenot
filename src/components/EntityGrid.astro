---
// The six companies of the group as logo cards on white.
// Each card links to /le-groupe#slug (the anchors the /le-groupe builder
// must render, one per entity, id = entity.slug).
//
//   <EntityGrid />                      (all six, from config.ts ENTITIES)
//   <EntityGrid linkBase="" />          (same page: links become #slug)
//   <EntityGrid showContact />          (adds verified phone + town)
//
// Props: entities? (default ENTITIES), linkBase? (default "/le-groupe"),
// showContact? (default false), headingLevel? (3).
import { Image } from 'astro:assets';
import { ENTITIES, type Entity } from '../config';
import Icon from './Icon.astro';

export interface Props {
  entities?: Entity[];
  linkBase?: string;
  showContact?: boolean;
  headingLevel?: 2 | 3;
}

const { entities = ENTITIES, linkBase = '/le-groupe', showContact = false, headingLevel = 3 } = Astro.props;
const H = headingLevel === 2 ? 'h2' : 'h3';
---

<ul role="list" class="entities">
  {
    entities.map((e, i) => (
      <li class="entity reveal" data-reveal-delay={String((i % 3) * 70)}>
        <div class="entity__logo">
          <Image
            src={e.logo}
            alt={e.logoAlt}
            width={Math.min(480, e.logo.width)}
            widths={[260, 480].filter((w) => w <= e.logo.width)}
            sizes="260px"
            format="webp"
            quality={90}
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="entity__body">
          <H class="entity__name">
            <a href={`${linkBase}#${e.slug}`} class="entity__link">
              {e.name}
              {e.shortName.length <= 4 && <span class="entity__short"> ({e.shortName})</span>}
            </a>
          </H>
          <p class="entity__role">{e.role}</p>
          {e.note && <p class="entity__note">{e.note}</p>}
          {showContact && (
            <p class="entity__contact">
              {e.addresses[0] && <span>{e.addresses[0].locality}</span>}
              {e.phone && <a href={e.phone.href} class="entity__tel">{e.phone.display}</a>}
            </p>
          )}
        </div>
        <span class="entity__arrow" aria-hidden="true"><Icon name="arrow" size={20} /></span>
      </li>
    ))
  }
</ul>

<style>
  .entities {
    display: grid;
    border-top: 1px solid var(--grey-200);
    border-left: 1px solid var(--grey-200);
  }
  @media (min-width: 640px) {
    .entities {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .entities {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .entity {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: clamp(1.5rem, 1.2rem + 1.2vw, 2.5rem);
    background: var(--paper);
    border-right: 1px solid var(--grey-200);
    border-bottom: 1px solid var(--grey-200);
    color: var(--grey-900);
    transition: box-shadow var(--dur) var(--ease-std);
  }
  .entity__logo {
    display: flex;
    align-items: center;
    height: 96px;
  }
  .entity__logo :global(img) {
    width: auto;
    max-width: min(100%, 260px);
    max-height: 96px;
    object-fit: contain;
  }
  .entity__body {
    display: grid;
    gap: 8px;
    padding-top: 20px;
    border-top: 1px solid var(--grey-200);
  }
  .entity__name {
    font-size: 1rem;
    font-weight: var(--fw-black);
    letter-spacing: 0.02em;
    line-height: 1.3;
    text-transform: uppercase;
  }
  .entity__short {
    color: var(--grey-500);
  }
  .entity__link {
    color: inherit;
    text-decoration: none;
  }
  .entity__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .entity__link:focus-visible {
    outline: none;
  }
  .entity:has(.entity__link:focus-visible) {
    outline: 2px solid var(--red);
    outline-offset: -2px;
  }
  .entity__role {
    font-size: var(--fs-small);
    color: var(--grey-600);
    padding-right: 28px;
  }
  .entity__note {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-micro);
    font-weight: var(--fw-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--red-text);
  }
  .entity__note::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--red);
  }
  .entity__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    font-size: var(--fs-small);
    color: var(--grey-600);
  }
  .entity__tel {
    position: relative;
    z-index: 1;
    font-weight: var(--fw-bold);
    color: var(--grey-900);
    white-space: nowrap;
  }
  .entity__arrow {
    position: absolute;
    right: clamp(1.5rem, 1.2rem + 1.2vw, 2.5rem);
    bottom: clamp(1.5rem, 1.2rem + 1.2vw, 2.5rem);
    color: var(--red);
    transition: transform var(--dur) var(--ease-out);
  }
  @media (hover: hover) {
    .entity:hover {
      box-shadow: inset 0 3px 0 var(--red);
    }
    .entity:hover .entity__arrow {
      transform: translateX(4px);
    }
  }
</style>
