---
// Band of key figures with count-up (countup.client.ts).
//
//   <StatBand items={KEY_FIGURES} chip="Parking sécurisé" />
//   <StatBand items={[{ value: 90, label: 'moteurs' }]} tone="light" />
//
// Props
//   items   Stat[] from config.ts: { value, suffix?, label, group? }
//           The server renders the final value; JS only animates it.
//   tone    'dark' (default) | 'light' | 'grey'
//   chip    optional extra fact without a number, e.g. "Parking sécurisé"
//   title   optional visually-hidden heading for the band (default
//           "Chiffres clés")
import type { Stat } from '../config';
import Icon from './Icon.astro';

export interface Props {
  items: Stat[];
  tone?: 'dark' | 'light' | 'grey';
  chip?: string;
  title?: string;
}

const { items, tone = 'dark', chip, title = 'Chiffres clés' } = Astro.props;
const NNBSP = ' ';
const fmt = (s: Stat) =>
  `${s.group ? String(s.value).replace(/\B(?=(\d{3})+(?!\d))/g, NNBSP) : String(s.value)}${s.suffix ?? ''}`;
const toneClass = tone === 'dark' ? 'is-dark' : tone === 'grey' ? 'is-grey' : '';
---

<section class:list={['stats', toneClass]} aria-label={title}>
  <div class="container container--wide">
    <ul role="list" class="stats__list">
      {
        items.map((s, i) => (
          <li class:list={['stats__item reveal', s.group && 'stats__item--wide']} data-reveal-delay={String(i * 60)}>
            <span class="stats__value">
              <span data-countup={s.value} data-countup-group={s.group ? '' : undefined}>
                {fmt(s)}
              </span>
              {s.suffix && <span class="stats__suffix">{s.suffix}</span>}
            </span>
            <span class="stats__label">{s.label}</span>
          </li>
        ))
      }
      {
        chip && (
          <li class="stats__item stats__item--chip reveal" data-reveal-delay={String(items.length * 60)}>
            <span class="stats__chip">
              <Icon name="parking" size={28} />
              <span>{chip}</span>
            </span>
          </li>
        )
      }
    </ul>
  </div>
</section>

<style>
  .stats {
    background: var(--bg);
    color: var(--fg);
    padding-block: clamp(3rem, 2.2rem + 3.4vw, 5rem);
  }
  /* Phone: 2 columns, the wide figure (20 000 m²) on its own row. */
  .stats__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 16px;
  }
  .stats__item {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-block: 22px;
    border-top: 1px solid var(--rule);
    min-width: 0;
  }
  .stats__item--wide,
  .stats__item--chip {
    grid-column: 1 / -1;
  }
  /* Tablet: 3 columns, wider third column. */
  @media (min-width: 720px) {
    .stats__list {
      grid-template-columns: 1fr 1fr 1.6fr;
      column-gap: 32px;
    }
    .stats__item--wide,
    .stats__item--chip {
      grid-column: auto;
    }
  }
  /* Desktop: one row, items sized to their content. */
  @media (min-width: 1100px) {
    .stats__list {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 24px 40px;
    }
    .stats__item {
      flex: 0 1 auto;
      padding-block: 24px 0;
      border-top-width: 1px;
    }
    .stats__label {
      max-width: 15ch;
    }
  }
  .stats__value {
    display: inline-flex;
    align-items: baseline;
    font-size: clamp(2.25rem, 1.2rem + 3.2vw, 4rem);
    font-weight: var(--fw-black);
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--fg);
  }
  .stats__value [data-countup] {
    display: inline-block;
    text-align: left;
  }
  .stats__suffix {
    font-size: 0.45em;
    letter-spacing: 0;
  }
  .stats__label {
    position: relative;
    padding-left: 18px;
    font-size: var(--fs-micro);
    font-weight: var(--fw-bold);
    letter-spacing: 0.12em;
    line-height: 1.45;
    text-transform: uppercase;
    color: var(--fg-2);
  }
  .stats__label::before {
    content: '';
    position: absolute;
    top: 0.35em;
    left: 0;
    width: 8px;
    height: 8px;
    background: var(--red);
  }
  .stats__item--chip {
    justify-content: center;
  }
  .stats__chip {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    align-self: flex-start;
    min-height: 56px;
    padding: 10px 18px;
    border: 1.5px solid var(--rule-strong);
    font-size: var(--fs-small);
    font-weight: var(--fw-black);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.3;
  }
  .stats__chip :global(svg) {
    flex: none;
    color: var(--red);
  }
</style>
