---
// /services: guarding, secure truck parking, chartering. Rhythm: dark head >
// white service blocks > dark "offre globale" > white CTA.
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import Button from '../components/Button.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import { ENTITIES, HISTORY_TEXT, NBSP, type Phone } from '../config';

import volvoFh from '../images/photos/volvo-fh.jpg';

const lgs = ENTITIES.find((e) => e.slug === 'lgs')!;
const eurocap = ENTITIES.find((e) => e.slug === 'eurocap')!;

interface Service {
  id: string;
  icon: IconName;
  title: string;
  entity?: string;
  paragraphs: string[];
  facts: string[];
  phone?: Phone;
  link: { href: string; label: string };
}

const services: Service[] = [
  {
    id: 'gardiennage',
    icon: 'shield',
    title: 'Gardiennage',
    entity: `${lgs.name} (${lgs.shortName})`,
    paragraphs: [
      'Logistique Gardiennage Services est la société du groupe dédiée au gardiennage et aux services.',
      'Elle complète l’offre transport et logistique, avec un interlocuteur joignable en direct.',
    ],
    facts: ['Gardiennage', 'Services associés', 'Une société du groupe'],
    phone: lgs.phone,
    link: { href: `/le-groupe#${lgs.slug}`, label: 'Découvrir LGS' },
  },
  {
    id: 'parking',
    icon: 'parking',
    title: 'Parking sécurisé pour poids lourds',
    paragraphs: [
      'Un espace sécurisé pour le stationnement des tracteurs et des semi-remorques, sur les sites du groupe.',
      `Capacité et conditions d’accès${NBSP}: contactez-nous pour en parler.`,
    ],
    facts: ['Tracteurs', 'Semi-remorques', 'Sur les sites du groupe'],
    link: { href: '/le-groupe', label: 'Découvrir le groupe' },
  },
  {
    id: 'affretement',
    icon: 'exchange',
    title: 'Affrètement et organisation de transports',
    entity: eurocap.name,
    paragraphs: [
      'Quand un flux dépasse la capacité de notre propre parc, ou demande un véhicule spécifique, Eurocap Transports l’organise avec des transporteurs partenaires.',
      'Depuis Pompey, en Meurthe-et-Moselle, pour un seul interlocuteur du chargement à la livraison.',
    ],
    facts: ['Affrètement', 'Organisation de transports', 'Transporteurs partenaires'],
    link: { href: `/le-groupe#${eurocap.slug}`, label: 'Découvrir Eurocap' },
  },
];

const metiers = [
  { href: '/transport', label: 'Transport routier de marchandises', note: 'Lots complets et partiels' },
  { href: '/logistique', label: 'Logistique & entreposage', note: `20${NBSP}000${NBSP}m² de stockage intérieur` },
  { href: '/le-groupe', label: 'Les six sociétés du groupe', note: 'Une offre globale' },
];
---

<Base
  title="Gardiennage, parking, affrètement"
  description={`Gardiennage avec LGS, parking sécurisé pour poids lourds, affrètement avec Eurocap${NBSP}: les services qui complètent transport et logistique.`}
  path="/services"
>
  <PageHead
    kicker="Services associés"
    title="Gardiennage, parking sécurisé, affrètement"
    lead="Les services qui complètent le transport et la logistique du groupe, pour sécuriser vos marchandises et absorber chaque flux."
    image={volvoFh}
    alt="Tracteur routier noir et sa semi-remorque, à l’arrêt en bord de route."
    crumbs={[{ label: 'Services' }]}
    position="50% 60%"
  >
    <Button slot="actions" href="/contact#devis" icon="arrow">Demander un devis</Button>
  </PageHead>

  <section class="section" aria-labelledby="services-titre">
    <div class="container">
      <SectionHead
        id="services-titre"
        kicker="Nos services"
        title="Trois services, en appui du transport"
        lead="Chaque service est porté par le groupe ou par l’une de ses sociétés, avec un contact direct."
      />
      <div class="svcs">
        {
          services.map((s, i) => (
            <article class="svc reveal" id={s.id} aria-labelledby={`${s.id}-titre`}>
              <div class="svc__head">
                <div class="svc__marks">
                  <span class="svc__icon"><Icon name={s.icon} size={44} strokeWidth={1.5} /></span>
                  <span class="svc__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                </div>
                <h3 id={`${s.id}-titre`} class="svc__title">{s.title}</h3>
                {s.entity && <p class="svc__entity">{s.entity}</p>}
              </div>
              <div class="svc__body">
                <div class="prose svc__prose">
                  {s.paragraphs.map((p) => <p>{p}</p>)}
                </div>
                <ul role="list" class="svc__facts">
                  {s.facts.map((f) => (
                    <li>
                      <Icon name="check" size={18} strokeWidth={2} />
                      {f}
                    </li>
                  ))}
                </ul>
                <div class="svc__actions">
                  {s.phone && (
                    <a class="svc__tel" href={s.phone.href}>
                      <Icon name="phone" size={20} />
                      {s.phone.display}
                    </a>
                  )}
                  <a class="link-arrow" href={s.link.href}>
                    {s.link.label}
                    <Icon name="arrow" />
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section is-dark" aria-labelledby="globale-titre">
    <div class="container global">
      <div class="global__text reveal">
        <p class="kicker">Une offre globale</p>
        <h2 id="globale-titre" class="h2 global__title">Transporter, stocker, sécuriser</h2>
        <p class="lead global__lead">{HISTORY_TEXT[1]}</p>
        <p class="global__note">
          Cette association a donné naissance à Berberat Thenot Logistique et à Berberat Thenot Expertise. Les services
          associés complètent aujourd’hui le transport et la logistique.
        </p>
      </div>
      <ul role="list" class="global__links reveal" data-reveal-delay="80">
        {
          metiers.map((m) => (
            <li>
              <a class="global__link" href={m.href}>
                <span class="global__label">
                  {m.label}
                  <span class="global__sub">{m.note}</span>
                </span>
                <Icon name="arrow" size={22} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand
    kicker="Devis services"
    title={`Un besoin de gardiennage ou d’affrètement${NBSP}?`}
    text={`Dans le formulaire de devis, choisissez «${NBSP}Gardiennage${NBSP}» ou «${NBSP}Autre${NBSP}», ou appelez directement le site le plus proche.`}
    button={{ label: 'Demander un devis', href: '/contact?besoin=gardiennage#devis' }}
  />
</Base>

<style>
  .svcs {
    border-top: 2px solid var(--rule-strong);
  }
  .svc {
    display: grid;
    gap: 24px;
    padding-block: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: 96px;
  }
  @media (min-width: 900px) {
    .svc {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr);
      gap: clamp(3rem, 1rem + 4vw, 6rem);
    }
  }
  .svc__marks {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    max-width: 22rem;
    margin-bottom: 20px;
  }
  .svc__icon {
    color: var(--red);
  }
  .svc__index {
    font-size: var(--fs-small);
    font-weight: var(--fw-black);
    letter-spacing: 0.1em;
    color: var(--fg-muted);
  }
  .svc__title {
    font-size: clamp(1.5rem, 1.1rem + 1.5vw, 2.25rem);
    font-weight: var(--fw-black);
    line-height: 1.1;
    letter-spacing: -0.005em;
    text-transform: uppercase;
    text-wrap: balance;
    max-width: 16ch;
    hyphens: manual;
    overflow-wrap: break-word;
  }
  .svc__entity {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    font-size: var(--fs-micro);
    font-weight: var(--fw-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .svc__entity::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    background: var(--red);
  }
  .svc__body {
    display: grid;
    gap: 24px;
    align-content: start;
  }
  @media (min-width: 900px) {
    .svc__body {
      padding-top: 64px;
    }
  }
  .svc__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
  }
  .svc__facts li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .svc__facts :global(svg) {
    flex: none;
    color: var(--red);
  }
  .svc__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 32px;
  }
  .svc__tel {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-size: 1.25rem;
    font-weight: var(--fw-black);
    color: var(--fg);
    text-decoration: none;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .svc__tel :global(svg) {
    color: var(--red);
  }
  @media (hover: hover) {
    .svc__tel:hover {
      text-decoration: underline;
      text-decoration-color: var(--red);
    }
  }
  .svc__actions .link-arrow {
    min-height: 44px;
  }

  .global {
    display: grid;
    gap: clamp(2.5rem, 2rem + 2vw, 4rem);
    align-items: end;
  }
  @media (min-width: 1024px) {
    .global {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: clamp(3rem, 1rem + 5vw, 7rem);
    }
  }
  .global__title {
    margin-top: 16px;
    max-width: 14ch;
    text-wrap: balance;
  }
  .global__lead {
    margin-top: 24px;
    max-width: 52ch;
  }
  .global__note {
    margin-top: 20px;
    max-width: 52ch;
    color: var(--fg-2);
  }
  .global__links {
    border-top: 2px solid var(--rule-strong);
  }
  .global__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 88px;
    padding-block: 18px;
    border-bottom: 1px solid var(--rule);
    color: var(--fg);
    text-decoration: none;
  }
  .global__label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-weight: var(--fw-black);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.3;
  }
  .global__sub {
    font-size: var(--fs-small);
    font-weight: var(--fw-regular);
    text-transform: none;
    letter-spacing: 0;
    color: var(--fg-muted);
  }
  .global__link :global(svg) {
    flex: none;
    color: var(--red);
    transition: transform var(--dur) var(--ease-out);
  }
  @media (hover: hover) {
    .global__link:hover :global(svg) {
      transform: translateX(4px);
    }
    .global__link:hover .global__label {
      text-decoration: underline;
      text-decoration-color: var(--red);
      text-underline-offset: 0.3em;
    }
  }
</style>
