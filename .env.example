# Contact form (api/contact.ts). Set these in Vercel > Project > Settings >
# Environment Variables. Never commit real values.

# Resend API key. Without it the form answers HTTP 503 and the page tells the
# visitor to call instead.
RESEND_API_KEY=

# Recipient of the devis and candidature e-mails (address to be validated with
# the client, see HANDOVER.md).
CONTACT_TO=

# Sender, on a domain verified in Resend, e.g.
# "Site Berberat Thenot <formulaire@domaine-verifie.fr>"
CONTACT_FROM=
